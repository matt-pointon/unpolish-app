{
  "buildCommand": "npm run build:site",
  "outputDirectory": "public",
  "framework": null,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/examples/react/:path((?!.*\\.).*)",
      "destination": "/examples/react/index.html"
    },
    {
      "source": "/examples/svelte/:path((?!.*\\.).*)",
      "destination": "/examples/svelte/index.html"
    }
  ],
  "headers": [
    {
      "source": "/unpolish/:version(\\d+\\.\\d+\\.\\d+)/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/site/release.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/unpolish/unpolish.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/unpolish/unpolish.config.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/unpolish/unpolish.config.schema.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/unpolish/README.md",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/unpolish/:file(.*\\.tgz)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
